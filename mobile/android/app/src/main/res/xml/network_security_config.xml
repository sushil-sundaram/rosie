<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Allow cleartext HTTP over Tailscale IP space (CGNAT 100.64.0.0/10) -->
        <!-- Note: Android requires specific hostnames or domains, IP ranges are not fully supported by domain-config. -->
        <!-- You must list your specific Tailscale MagicDNS or exact IP here. -->
        <domain includeSubdomains="true">100.64.0.0</domain> <!-- Replace with exact IP -->
        <!-- Example Tailnet domain: -->
        <domain includeSubdomains="true">your-tailnet.ts.net</domain>
    </domain-config>
    <!-- Alternatively, allow all cleartext traffic (use with caution) -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
